.env
web/.env

# Composer dependencies (composer.json and composer.lock ARE tracked)
vendor/

# OS / Editor files
.DS_Store
Thumbs.db
*.log

# PHPStorm / VSCode
.idea/
.vscode/

# User-uploaded policy PDFs (not source-controlled)
assets/uploads/policies/*
!assets/uploads/policies/.gitkeep

# Local DB backups (not source-controlled)
storage/backups/*
!storage/backups/.gitkeep

# User-uploaded engagement planning docs (not source-controlled)
storage/planning_docs/*
!storage/planning_docs/.gitkeep
